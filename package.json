{
  "name": "pirate-battle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --update-snapshots=all",
    "report": "playwright show-report",
    "format": "prettier --write src tests scripts *.ts *.js *.json *.yaml *.md",
    "format:check": "prettier --check src tests scripts *.ts *.js *.json *.yaml *.md",
    "build:profile": "tsc -b && vite build --mode profile",
    "profile": "pnpm build:profile && node scripts/profile.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "@tanstack/react-query": "^5.90.0",
    "axios": "^1.12.0",
    "msw": "^2.11.0",
    "pixi.js": "^8.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
